// Part 1a: Arithmetic Operations
let a = 10;
let b = 3;

console.log("Addition:", a + b);         // 10 + 3 = 13
console.log("Subtraction:", a - b);      // 10 - 3 = 7
console.log("Multiplication:", a * b);   // 10 * 3 = 30
console.log("Division:", a / b);         // 10 / 3 ≈ 3.333...
console.log("Modulus:", a % b);          // 10 % 3 = 1

// Comparision 

console.log(10 == "10");     // true (loose equality)
console.log(10 === "10");    // false (strict equality)
console.log(5 < 10);         // true
console.log(15 > 20);        // false

// Logical

const isStudent = true;
const hasID = false;

console.log(isStudent && hasID); // false
console.log(isStudent || hasID); // true
console.log(!hasID);             // true

// Implicit coercion
console.log("5" + 1);         // "51"
console.log("5" - 1);         // 4
console.log(true + "yes");    // "trueyes"
console.log(false + 5);       // 5

//Explicit conversion
console.log(Number("42"));    // 42
console.log(String(123));     // "123"
console.log(Boolean(0));      // false

