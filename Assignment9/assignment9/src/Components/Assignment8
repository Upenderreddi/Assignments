//d.More Array Methods (try all and log results)
//const numbers = [1, 2, 3, 4, 5];

let numbers = [1, 2, 3, 4, 5];
console.log("Original array:", numbers);

// 1. Add .unshift
numbers.unshift(0);
console.log("After unshift(0):", numbers); 

//2.  Add .shift
numbers.shift();
console.log("After shift():", numbers); 

//3. .includes()
console.log("Includes 3:", numbers.includes(3)); // true
console.log("Includes 9:", numbers.includes(9)); // false

//.indexof()
console.log("Index of 4:", numbers.indexOf(4)); // 3
console.log("Index of 9:", numbers.indexOf(9)); // -1 (not found)
// .slice()
let sliced = numbers.slice(1, 4);  // from index 1 to 3
console.log("Sliced (1, 4):", sliced); // [2, 3, 4]
console.log("Original after slice:", numbers); // unchanged

//.splice()
let spliced = numbers.splice(2, 2);  
console.log("Spliced (2, 2):", spliced); // [3, 4]
console.log("After splice:", numbers);  // [1, 2, 5]

// .reverse
numbers.reverse();
console.log("After reverse():", numbers); // [5, 2, 1]

// Final output
// Original array: [1, 2, 3, 4, 5]
// After unshift(0): [0, 1, 2, 3, 4, 5]
// After shift(): [1, 2, 3, 4, 5]
// Includes 3: true
// Includes 9: false
// Index of 4: 3
// Index of 9: -1
// Sliced (1, 4): [2, 3, 4]
// Original after slice: [1, 2, 3, 4, 5]
// Spliced (2, 2): [3, 4]
// After splice: [1, 2, 5]
// After reverse(): [5, 2, 1]

