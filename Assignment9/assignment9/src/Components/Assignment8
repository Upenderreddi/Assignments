// Basic function
function greet() {
    console.log("Welcome to the site!");
}

greet(); // Output: Welcome to the site!

// Function with one parameter

function greetUser(name) {
    console.log("Hello, " + name);
}

greetUser("Alice"); // Output: Hello, Alice

//Function with two parameter
function addNumbers(a, b) {
    console.log("Sum:", a + b);
}

addNumbers(5, 7); // Output: Sum: 12

//4. Function that Returns a Value
function subtractNumbers(x, y) {
    return x - y;
}

let difference = subtractNumbers(10, 4);
console.log("Difference:", difference); // Output: Difference: 6

// 5. Function Using a Comparison Operator
function isGreaterThan100(num) {
    return num > 100;
}

console.log(isGreaterThan100(150)); // Output: true
console.log(isGreaterThan100(80));  // Output: false

//6.Function Using a Logical Operator
function bothTrue(a, b) {
    return a && b;
}

console.log(bothTrue(true, true));   // Output: true
console.log(bothTrue(true, false));  // Output: false

